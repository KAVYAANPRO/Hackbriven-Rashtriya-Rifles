# Story engine (Stage 2: Intelligence)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Image generation (Stage 4: Generation)
NVIDIA_API_KEY=
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.1-dev
# Pollinations fallback needs no key

# Voice (Stage 5) - tried in order: edge-tts -> gTTS. Neither needs a key.
EDGE_TTS_VOICE=en-US-AriaNeural

# Captions (Stage 6) - tried in order: Groq-hosted Whisper (reuses
# GROQ_API_KEY above, cloud GPU, fast) -> local faster-whisper (no key, CPU,
# fallback only).
WHISPER_MODEL=base

# Optional motion (Stage 7) - tried in order: 8scale -> Magic Hour -> Ken Burns
FAL_API_KEY=
FAL_MOTION_MODEL=fal-ai/ltx-video
# 8scale.com: 10 free generations per key, no card, real generative
# image-to-video (Wan 2.2 14B). Tried first.
# EIGHTSCALE_API_KEYS is a comma-separated pool of keys from MULTIPLE free
# accounts (e.g. "key_from_account_1,key_from_account_2,key_from_account_3")
# - each account's 10 free generations is small, so the pipeline rotates
# through the whole pool, exhausting one account before trying the next,
# instead of falling through to Magic Hour the moment one account runs out.
# EIGHTSCALE_API_KEY (singular) still works as a one-key pool.
EIGHTSCALE_API_KEY=
EIGHTSCALE_API_KEYS=
EIGHTSCALE_MODEL=wan-2.2/14b/image-to-video
EIGHTSCALE_RESOLUTION=480p
# Magic Hour: free tier (400 credits, no card), ~120 credits per 5s clip at
# 480p. Fallback when every 8scale account in the pool is exhausted.
# MAGIC_HOUR_API_KEYS is the same multi-account comma-separated pool pattern
# as EIGHTSCALE_API_KEYS above; MAGIC_HOUR_API_KEY (singular) still works.
# MAGIC_HOUR_MAX_SCENES_PER_JOB caps how many scenes per video attempt real
# motion at all (rest fall back to Ken Burns) - applies regardless of which
# provider/account ends up serving the request.
MAGIC_HOUR_API_KEY=
MAGIC_HOUR_API_KEYS=
MAGIC_HOUR_RESOLUTION=480p
MAGIC_HOUR_MAX_SCENES_PER_JOB=2

# Credits ledger (durable across restarts). When unset, falls back to a
# local SQLite file (fine for local dev, not for an ephemeral deployment
# like a Hugging Face Space - see TECH.md).
MONGODB_URI=
MONGODB_DB_NAME=app

# Razorpay (client credit top-ups). Use a rzp_test_ key first - test mode
# charges nothing real and is otherwise identical to live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Storage & output
STORAGE_DIR=storage/jobs
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
MAX_REGENERATE_ATTEMPTS=2

# Provider HTTP timeouts (seconds)
PROVIDER_TIMEOUT_SECONDS=30

# Shared-secret auth for mutating endpoints (create/approve/publish/cancel
# job, credit top-ups). Empty = auth disabled (fine for local dev/demo, NOT
# for a real deployment - set this before exposing the API publicly).
BACKEND_API_KEY=

# --- Accounts (email + password sign-in used by the React frontend) ---
# Secret used to sign session tokens and media links. If blank, a random one is
# generated once and saved in STORAGE_DIR (fine locally). SET THIS on any host
# with an ephemeral disk, or every restart signs everyone out.
SESSION_SECRET=
SESSION_TTL_HOURS=336
# true = every user-scoped endpoint needs a login (recommended for a real deployment).
# false = callers without a token share one anonymous "default" account (legacy behaviour).
REQUIRE_LOGIN=false
# Credits granted once to each new account (matches the Free plan's starter balance).
SIGNUP_CREDITS=20

# Browser origins allowed to call the API directly (comma-separated). The Vite
# dev server proxies /api, so this only matters for a separately-hosted frontend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Reference-image uploads
MAX_UPLOAD_IMAGES=8
MAX_UPLOAD_BYTES=10485760

# --- Images (tried in this order; unconfigured ones are skipped) ---
# Cloudflare Workers AI - FREE, no credit card: ~10,000 neurons/day = roughly 200 FLUX images/day.
# dash.cloudflare.com -> sign up -> copy the Account ID (right sidebar of any zone/Workers page)
# -> My Profile -> API Tokens -> Create Token -> "Workers AI" template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODELS=@cf/black-forest-labs/flux-1-schnell
# OpenRouter images need a PURCHASED OpenRouter balance (a never-funded account gets HTTP 402).
OPENROUTER_IMAGE_MODELS=bytedance-seed/seedream-5-0-pro,qwen/qwen-image-3-pro
NVIDIA_IMAGE_TIMEOUT_SECONDS=25
# Keyless last resort (small watermarked squares) before the plain gradient card.
IMAGE_USE_POLLINATIONS=true
# After a provider fails, skip it this many seconds instead of waiting on it for every scene.
PROVIDER_COOLDOWN_SECONDS=600

# --- Text models: backups tried inside each provider when its main model is overloaded ---
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
OPENROUTER_FALLBACK_MODELS=qwen/qwen3.8-27b:free

# --- Resolution enhancement (server-side only; the UI never names the service) ---
# fal.ai video upscaler for 480p motion clips and 4K delivery. Needs a funded FAL_API_KEY;
# without one, 4K falls back to high-quality local scaling.
ENHANCE_MOTION_CLIPS=true
UPSCALE_FAL_ENDPOINT=fal-ai/topaz/upscale/video
