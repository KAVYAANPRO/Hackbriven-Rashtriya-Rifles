# IdeaFeed AI — environment variable template
# Copy this to .env and fill in your values. Never commit .env to git.

# API Configuration
VITE_API_BASE=http://localhost:8000

# Razorpay (use test keys in dev, live keys only in production)
VITE_RAZORPAY_KEY=rzp_test_XXXXXXXXXXXX

# Feature flags
VITE_ENABLE_ORCHESTRA=false
VITE_ENABLE_ANALYTICS=true
